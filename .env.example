# Both set: real Jev. Either missing: keyword fallback, so the app always runs.
# Locally these go in .env.local (npm run eval) and .dev.vars (wrangler pages dev).
# In production they are Cloudflare Pages secrets.
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_API_KEY=

# Optional. Pin a version once a threshold has been chosen against it.
JEV_MODEL=jev-latest
